# Sensitive / environment-specific
api/config.php
.env
.installed

.firecrawl/
backups/*.sql
backups/*.sql.gz
uploads/*
!uploads/.gitkeep
!uploads/.htaccess

# Source archives / backups / runtime logs (never commit)
*.zip
logs/
backups/remote/

# Local tooling
.claude/

# One-off local scripts and reconciliation dumps
_tmp_*
backend/scripts/.tmp-*

# OS / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Runtime state of the scheduler / locks
backups/*.lock
backups/scheduler_state.json

# میز کار files (server data, never committed or rsynced)
storage/work/*
!storage/work/.gitkeep

# Brainstorm companion mockups
.superpowers/
